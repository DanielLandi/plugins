{
  "$schema": "../../../../schema/transition.schema.json",
  "id": "halftone-wipe",
  "name": "Halftone Wipe",
  "version": "1.0.0",
  "summary": "A wave of dots grows across the frame, from tiny to touching, with the new scene inside them.",
  "uses": [
    "Print, comic and pop-art looks",
    "Graphic reveals",
    "Editorial content"
  ],
  "family": "03-wipe",
  "subfamily": "pattern",
  "facets": {
    "structure": "direct",
    "origin": "edge-left",
    "edge": "geometric",
    "layers": "B",
    "space": "2d",
    "timing": "eased",
    "tone": [
      "retro",
      "bold"
    ],
    "function": [
      "progression",
      "reveal"
    ],
    "also": []
  },
  "duration": {
    "default": 36,
    "min": 16,
    "max": 72
  },
  "overlay": false,
  "requires": [],
  "params": [
    {
      "name": "columns",
      "type": "integer",
      "default": 28,
      "min": 8,
      "max": 60,
      "description": "Dots across the frame."
    },
    {
      "name": "angle",
      "type": "number",
      "default": 30,
      "min": 0,
      "max": 360,
      "description": "Direction the wave travels, in degrees."
    }
  ],
  "presets": [],
  "authors": [
    "GTKottman"
  ],
  "changelog": [
    {
      "version": "1.0.0",
      "date": "2026-10-06",
      "notes": "First version."
    }
  ]
}
