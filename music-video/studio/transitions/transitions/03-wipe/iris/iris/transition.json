{
  "$schema": "../../../../schema/transition.schema.json",
  "id": "iris",
  "name": "Iris",
  "version": "1.0.0",
  "summary": "A circle opens from a point and grows until the new scene fills the frame.",
  "uses": [
    "Reveals",
    "Retro and cartoon looks",
    "Focusing on a subject"
  ],
  "family": "03-wipe",
  "subfamily": "iris",
  "facets": {
    "structure": "direct",
    "origin": "point",
    "edge": "hard",
    "layers": "B",
    "space": "2d",
    "timing": "eased",
    "tone": [
      "retro",
      "playful",
      "clean"
    ],
    "function": [
      "reveal"
    ],
    "also": []
  },
  "duration": {
    "default": 24,
    "min": 10,
    "max": 60
  },
  "overlay": false,
  "requires": [],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "Centre x (0..1)."
    },
    {
      "name": "y",
      "type": "number",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "Centre y (0..1)."
    },
    {
      "name": "softness",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 200,
      "description": "Edge softness in pixels."
    }
  ],
  "presets": [],
  "authors": [
    "GTKottman"
  ],
  "changelog": [
    {
      "version": "1.0.0",
      "date": "2026-10-06",
      "notes": "First version."
    }
  ]
}
