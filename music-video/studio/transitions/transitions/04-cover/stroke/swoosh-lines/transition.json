{
  "$schema": "../../../../schema/transition.schema.json",
  "id": "swoosh-lines",
  "name": "Swoosh Lines",
  "version": "1.0.0",
  "summary": "Waves of rounded diagonal ribbons sweep across, the last wave in the new background colour, then sweep on out to show the new scene.",
  "uses": [
    "Energetic social and promo edits",
    "Sports and music",
    "Brand moments"
  ],
  "family": "04-cover",
  "subfamily": "stroke",
  "facets": {
    "structure": "bridged",
    "origin": "edge-diagonal",
    "edge": "geometric",
    "layers": "third",
    "space": "2d",
    "timing": "eased",
    "tone": [
      "bold",
      "playful"
    ],
    "function": [
      "energy",
      "section-break",
      "brand"
    ],
    "also": []
  },
  "duration": {
    "default": 48,
    "min": 24,
    "max": 90
  },
  "overlay": true,
  "requires": [],
  "params": [
    {
      "name": "colors",
      "type": "colors",
      "default": [
        "#111111",
        "#FF4F1A"
      ],
      "description": "One colour per wave; the last wave covers the frame (use the incoming background colour)."
    },
    {
      "name": "ribbons",
      "type": "integer",
      "default": 7,
      "min": 3,
      "max": 16,
      "description": "Ribbons per wave."
    },
    {
      "name": "angle",
      "type": "number",
      "default": -28,
      "min": -60,
      "max": 60,
      "description": "Ribbon angle in degrees."
    },
    {
      "name": "hold",
      "type": "number",
      "default": 0.1,
      "min": 0,
      "max": 0.4,
      "description": "Share of the transition spent fully covered."
    }
  ],
  "presets": [],
  "authors": [
    "GTKottman"
  ],
  "changelog": [
    {
      "version": "1.0.0",
      "date": "2026-10-06",
      "notes": "First version."
    }
  ]
}
