  "uses": [
    "Time passing",
    "Soft scene changes",
    "Montages"
  ],
  "family": "02-blend",
  "subfamily": "crossfade",
  "facets": {
    "structure": "direct",
    "origin": "whole-frame",
    "edge": "none",
