{
  "$schema": "../../../../schema/transition.schema.json",
  "id": "grid-zoom",
  "name": "Grid Zoom",
  "version": "1.0.0",
  "summary": "The camera pulls back until the old scene is one tile in a grid of tiles in the new colour, glides to the next tile and dives into it, which becomes the new scene.",
  "uses": [
    "Changing topic within a series",
    "Galleries and portfolios",
    "Explainers with many sections"
  ],
  "family": "05-motion",
  "subfamily": "zoom",
  "facets": {
    "structure": "continuous",
    "origin": "whole-frame",
    "edge": "hard",
    "layers": "A+B",
    "space": "2d",
    "timing": "eased",
    "tone": [
      "clean",
      "technical"
    ],
    "function": [
      "continuity",
      "progression"
    ],
    "also": [
      "08-carry/portal"
    ]
  },
  "duration": {
    "default": 54,
    "min": 30,
    "max": 100
  },
  "overlay": false,
  "requires": [],
  "params": [
    {
      "name": "color",
      "type": "color",
      "default": "#FF4F1A",
      "description": "Colour of the other tiles; use the incoming scene's background colour."
    },
    {
      "name": "background",
      "type": "color",
      "default": "#111111",
      "description": "Colour between the tiles."
    },
    {
      "name": "zoom",
      "type": "number",
      "default": 0.3,
      "min": 0.15,
      "max": 0.6,
      "description": "Tile size when pulled back, as a share of the frame."
    },
    {
      "name": "direction",
      "type": "enum",
      "default": "left",
      "options": [
        "left",
        "right",
        "up",
        "down"
      ],
      "description": "Direction the motion travels."
    }
  ],
  "presets": [],
  "authors": [
    "GTKottman"
  ],
  "changelog": [
    {
      "version": "1.0.0",
      "date": "2026-10-06",
      "notes": "First version."
    }
  ]
}
