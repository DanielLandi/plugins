{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": { "@mv/kit": ["kit"], "@mv/kit/*": ["kit/*"], "@mv/assets/*": ["assets/*"], "@mv/web-entry": ["web/default-entry.ts"], "@mv/web-styles": ["web/no-styles.css"] }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
